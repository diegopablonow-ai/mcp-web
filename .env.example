# =============================================================================
# MCP Builder — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API — backend URLs
#
# NEXT_PUBLIC_API_BASE_URL  Exposed to the browser. Used by apiFetch() in
#                           client components and as a fallback for server-side
#                           calls. Inlined at build time by Next.js.
#
# API_BASE_URL              Server-only. Used by all Route Handlers and SSE
#                           proxies for service-to-service calls. May point to
#                           an internal VPC address that is unreachable from
#                           the browser. Falls back to NEXT_PUBLIC_API_BASE_URL
#                           when unset.
#
# Files that read API_BASE_URL (server-side only):
#   app/api/auth/login/route.ts
#   app/api/auth/signup/route.ts
#   app/api/auth/refresh/route.ts
#   app/api/sse/ai-jobs/route.ts
#   app/api/sse/logs/route.ts
#   app/api/stripe/webhook/route.ts
#
# Files that read NEXT_PUBLIC_API_BASE_URL (client-side):
#   lib/constants.ts  →  API_BASE_URL used by apiFetch()
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.mcp-builder.com
API_BASE_URL=https://api.mcp-builder.com

# -----------------------------------------------------------------------------
# Auth — JWT secret
#
# Must match the secret the backend uses to sign tokens (HMAC-SHA256).
# Read by: lib/jwt.ts, lib/mock-auth.ts, proxy.ts
#
# Behaviour by environment:
#   development   — optional; absence skips signature verification with a
#                   console.warn (structurally valid non-expired tokens pass).
#   production    — required; absence causes a hard crash on first request so
#                   the deployment fails fast rather than running unsecured.
#
# Minimum recommended length: 32 random characters.
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-at-least-32-chars

# -----------------------------------------------------------------------------
# Auth — mock mode
#
# MOCK_AUTH              Set to "true" to bypass real backend auth in Route
#                        Handlers. Generates locally signed JWTs (real
#                        HMAC-SHA256 when JWT_SECRET is set). Server-side only.
#                        Read by: app/api/auth/login, signup, refresh.
#
# NEXT_PUBLIC_USE_MOCK   Set to "true" to make all service calls return
#                        in-memory mock data instead of hitting the backend.
#                        Client + server. Read by: lib/constants.ts.
#
# Both flags are hard-gated to NODE_ENV !== "production" in the code —
# setting them in a production environment has no effect.
# -----------------------------------------------------------------------------
MOCK_AUTH=false
NEXT_PUBLIC_USE_MOCK=false

# -----------------------------------------------------------------------------
# Stripe
#
# STRIPE_SECRET_KEY       Server-side Stripe API key (sk_live_* / sk_test_*).
#                         Read by: app/api/stripe/checkout/route.ts
#                         When absent, checkout falls back to a mock redirect
#                         URL (non-production only).
#
# STRIPE_WEBHOOK_SECRET   Signing secret from Stripe Dashboard → Webhooks
#                         (whsec_*). Required for signature verification.
#                         Read by: app/api/stripe/webhook/route.ts
#                         Absence returns 500 so Stripe retries the event.
#
# STRIPE_PRICE_PRO        Price ID for the Pro plan (price_*).
# STRIPE_PRICE_SCALE      Price ID for the Scale plan (price_*).
# STRIPE_PRICE_ENTERPRISE Price ID for the Enterprise plan (price_*).
# STRIPE_PRICE_QUOTA_UNIT Price ID for per-1000-credit quota top-ups (price_*).
#                         All four read by: app/api/stripe/checkout/route.ts
#                         Obtain from Stripe Dashboard → Products → Prices.
#
# INTERNAL_API_SECRET     Shared secret for authenticated server-to-server
#                         calls from the webhook handler to the backend API.
#                         Sent as X-Internal-Secret header. Optional — omit
#                         only if the backend doesn't require it.
#                         Read by: app/api/stripe/webhook/route.ts
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCALE=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_QUOTA_UNIT=price_...
INTERNAL_API_SECRET=your-internal-api-secret

# -----------------------------------------------------------------------------
# NODE_ENV
#
# Set automatically by Next.js — do not set manually.
#   "development"  next dev
#   "production"   next build && next start
#   "test"         test runners
#
# Controls: mock-mode guards, JWT_SECRET enforcement, secure cookie flag,
#           Vercel Analytics rendering.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Rate limiting & webhook idempotency — Upstash Redis
#
# Required for production on serverless/edge (Vercel).
# Without these, rate limiting is in-memory (resets on cold start) and
# webhook deduplication is process-local only.
#
# Create a free database at https://upstash.com → Redis → Create Database.
#
# UPSTASH_REDIS_REST_URL   REST endpoint (https://xxx.upstash.io)
# UPSTASH_REDIS_REST_TOKEN Read-write token from the Upstash console
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# Error tracking — Sentry (strongly recommended for production)
#
# 1. pnpm add @sentry/nextjs
# 2. npx @sentry/wizard@latest -i nextjs
# 3. Set SENTRY_DSN (Sentry → Project → Settings → Client Keys)
# 4. Uncomment the Sentry block in lib/reportError.ts
# -----------------------------------------------------------------------------
SENTRY_DSN=https://xxx@oxx.ingest.sentry.io/xxx
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=mcp-builder-web

# -----------------------------------------------------------------------------
# CSRF — allowed origin for POST requests to /api/auth/*
# Defaults to request origin. Set explicitly for multi-domain setups.
# -----------------------------------------------------------------------------
ALLOWED_ORIGIN=https://app.mcp-builder.com

# -----------------------------------------------------------------------------
# Logging — minimum log level for lib/logger.ts (debug|info|warn|error)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
